rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(hid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }

    function isAdmin(hid) {
      return isMember(hid) &&
        get(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)).data.role == 'admin';
    }

    function isMemberUid(hid, uid) {
      return exists(/databases/$(database)/documents/households/$(hid)/members/$(uid));
    }

    function shortText(value, max) {
      return value is string && value.size() <= max;
    }

    // Pozycja listy zakupów. Pola opcjonalne są zawsze tekstami (puste = brak).
    function validShoppingItem(hid, d) {
      return d.keys().hasOnly(['name', 'quantity', 'unit', 'storeCategory', 'checked',
                               'checkedBy', 'addedBy', 'createdAt'])
        && d.keys().hasAll(['name', 'storeCategory', 'checked', 'addedBy', 'createdAt'])
        && shortText(d.name, 100) && d.name.size() >= 1
        && shortText(d.get('quantity', ''), 20)
        && shortText(d.get('unit', ''), 20)
        && shortText(d.storeCategory, 30)
        && d.checked is bool
        && (d.get('checkedBy', null) == null || d.checkedBy is string)
        && d.addedBy is string && isMemberUid(hid, d.addedBy)
        && d.createdAt is timestamp && d.createdAt <= request.time;
    }

    function validShoppingHistory(d) {
      return d.keys().hasOnly(['name', 'count', 'lastAddedAt', 'storeCategory', 'quantity', 'unit'])
        && d.keys().hasAll(['name', 'count', 'lastAddedAt'])
        && shortText(d.name, 100) && d.name.size() >= 1
        && d.count is int && d.count >= 1
        && d.lastAddedAt is timestamp
        && shortText(d.get('storeCategory', ''), 30)
        && shortText(d.get('quantity', ''), 20)
        && shortText(d.get('unit', ''), 20);
    }

    // Notatka (bez pól własności; te sprawdzają reguły kolekcji).
    function validNoteFields(d) {
      return shortText(d.title, 200)
        && shortText(d.body, 20000)
        && d.pinned is bool
        && d.updatedAt is timestamp
        && (d.title.size() >= 1 || d.body.size() >= 1);
    }

    function validRecurrence(r) {
      return r == null
        || (r is map
            && r.keys().hasOnly(['type', 'until'])
            && r.type in ['weekly', 'monthly', 'yearly']
            && (r.get('until', null) == null || r.until is timestamp));
    }

    function validEventFields(d) {
      return shortText(d.title, 200) && d.title.size() >= 1
        && d.start is timestamp && d.end is timestamp && d.end >= d.start
        && d.allDay is bool
        && shortText(d.get('location', ''), 200)
        && shortText(d.get('description', ''), 5000)
        && (d.get('reminderMinutes', null) == null || d.reminderMinutes is int)
        && (!('colorIndex' in d) || (d.colorIndex is int && d.colorIndex >= 0 && d.colorIndex <= 4))
        && (d.get('typeId', null) == null || shortText(d.typeId, 64))
        && validRecurrence(d.get('recurrence', null));
    }

    function validSharedNote(hid, d) {
      return d.keys().hasOnly(['title', 'body', 'pinned', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['title', 'body', 'pinned', 'createdBy', 'updatedAt'])
        && validNoteFields(d) && d.createdBy is string && isMemberUid(hid, d.createdBy);
    }

    function validPrivateNote(d) {
      return d.keys().hasOnly(['title', 'body', 'pinned', 'updatedAt'])
        && d.keys().hasAll(['title', 'body', 'pinned', 'updatedAt'])
        && validNoteFields(d);
    }

    function validSharedEvent(hid, d) {
      return d.keys().hasOnly(['title', 'start', 'end', 'allDay', 'location', 'description',
                               'participants', 'reminderMinutes', 'recurrence', 'createdBy', 'colorIndex', 'typeId'])
        && d.keys().hasAll(['title', 'start', 'end', 'allDay', 'createdBy'])
        && validEventFields(d)
        && d.get('participants', []) is list
        && d.createdBy is string && isMemberUid(hid, d.createdBy);
    }

    function validPrivateEvent(d) {
      return d.keys().hasOnly(['title', 'start', 'end', 'allDay', 'location', 'description',
                               'reminderMinutes', 'recurrence', 'colorIndex', 'typeId'])
        && d.keys().hasAll(['title', 'start', 'end', 'allDay'])
        && validEventFields(d);
    }

    function isDay(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validChoreRecurrence(r) {
      return r is map
        && r.keys().hasOnly(['type', 'interval', 'weekdays', 'monthDay', 'dates', 'until'])
        && r.type in ['daily', 'weekly', 'monthly', 'customDates']
        && (!('interval' in r) || (r.interval is int && r.interval >= 1 && r.interval <= 365))
        && (!('weekdays' in r) || (r.weekdays is list && r.weekdays.size() <= 7))
        && (!('monthDay' in r) || (r.monthDay is int && r.monthDay >= 1 && r.monthDay <= 31))
        && (!('dates' in r) || (r.dates is list && r.dates.size() <= 366))
        && (r.get('until', null) == null || isDay(r.until));
    }

    function validChoreRule(hid, d) {
      return d.keys().hasOnly(['title', 'description', 'assigneeId', 'mode', 'startDate',
                               'recurrence', 'reminderTime', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['title', 'mode', 'startDate', 'createdBy', 'updatedAt'])
        && shortText(d.title, 200) && d.title.size() >= 1
        && shortText(d.get('description', ''), 2000)
        && (d.get('assigneeId', null) == null || (d.assigneeId is string && isMemberUid(hid, d.assigneeId)))
        && d.mode in ['once', 'recurring']
        && isDay(d.startDate)
        && (d.mode == 'once'
            ? d.get('recurrence', null) == null
            : validChoreRecurrence(d.recurrence))
        && (d.get('reminderTime', null) == null
            || (d.reminderTime is string && d.reminderTime.matches('^[0-9]{2}:[0-9]{2}$')))
        && d.createdBy is string && isMemberUid(hid, d.createdBy)
        && d.updatedAt is timestamp;
    }

    function validCategory(d) {
      return d.keys().hasOnly(['name', 'icon', 'colorIndex', 'order'])
        && d.keys().hasAll(['name', 'icon', 'colorIndex', 'order'])
        && shortText(d.name, 60) && d.name.size() >= 1
        && shortText(d.icon, 40)
        && d.colorIndex is int && d.colorIndex >= 0 && d.colorIndex <= 4
        && d.order is int;
    }

    function validExpense(hid, d) {
      return d.keys().hasOnly(['amount', 'date', 'month', 'categoryId', 'note', 'paidBy', 'createdBy', 'createdAt'])
        && d.keys().hasAll(['amount', 'date', 'month', 'categoryId', 'createdBy', 'createdAt'])
        && d.amount is int && d.amount >= 1 && d.amount <= 100000000
        && isDay(d.date)
        && d.month is string && d.month == d.date[0:7]
        && shortText(d.categoryId, 64) && d.categoryId.size() >= 1
        && shortText(d.get('note', ''), 200)
        && (d.get('paidBy', null) == null || (d.paidBy is string && isMemberUid(hid, d.paidBy)))
        && d.createdBy is string && isMemberUid(hid, d.createdBy)
        && d.createdAt is timestamp;
    }

    function validBudgetPlan(d) {
      return d.keys().hasOnly(['limits', 'total', 'updatedAt', 'alerted100'])
        && d.keys().hasAll(['limits', 'total', 'updatedAt'])
        && d.limits is map
        && d.total is int && d.total >= 0
        && (!('alerted100' in d) || d.alerted100 is bool)
        && d.updatedAt is timestamp;
    }

    function validEventType(d) {
      return d.keys().hasOnly(['name', 'colorIndex', 'order'])
        && d.keys().hasAll(['name', 'colorIndex', 'order'])
        && shortText(d.name, 40) && d.name.size() >= 1
        && d.colorIndex is int && d.colorIndex >= 0 && d.colorIndex <= 4
        && d.order is int;
    }

    // Autor wpisu wspólnego albo Administrator domu.
    function isAuthorOrAdmin(hid) {
      return resource.data.createdBy == request.auth.uid || isAdmin(hid);
    }

    // Profil użytkownika. householdId ustawia wyłącznie serwer (Cloud Functions).
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && !('householdId' in request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('householdId', null) == resource.data.get('householdId', null);
      allow delete: if false;

      // Wpisy prywatne: wyłącznie właściciel, nawet Administrator ich nie widzi.
      match /privateNotes/{id} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && validPrivateNote(request.resource.data);
      }
      match /privateEvents/{id} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && validPrivateEvent(request.resource.data);
      }
    }

    match /households/{hid} {
      // Dom zakłada funkcja createHousehold.
      allow read: if isMember(hid);
      allow update: if isAdmin(hid)
        && request.resource.data.createdBy == resource.data.createdBy;
      allow create, delete: if false;

      // Członkostwo i role zmieniają wyłącznie funkcje (ochrona ostatniego admina).
      match /members/{uid} {
        allow read: if isMember(hid);
        allow write: if false;
      }

      // Zaproszenia tworzy i realizuje serwer; admin może je czytać.
      match /invites/{code} {
        allow read: if isAdmin(hid);
        allow write: if false;
      }

      // Lista zakupów: wspólna dla całego domu.
      match /shoppingLists/{listId}/items/{itemId} {
        allow read: if isMember(hid);
        allow create: if isMember(hid) && validShoppingItem(hid, request.resource.data)
          && (request.resource.data.checked == false
              || request.resource.data.get('checkedBy', null) != null);
        allow update: if isMember(hid) && validShoppingItem(hid, request.resource.data)
          && request.resource.data.addedBy == resource.data.addedBy
          && request.resource.data.createdAt == resource.data.createdAt
          && (request.resource.data.checked
              ? request.resource.data.get('checkedBy', null) == request.auth.uid
              : request.resource.data.get('checkedBy', null) == null);
        allow delete: if isMember(hid);
      }

      // Historia nazw do podpowiedzi (przeżywa „Wyczyść kupione”).
      match /shoppingHistory/{key} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid) && validShoppingHistory(request.resource.data);
      }

      // Notatki wspólne: wszyscy czytają; autor lub Administrator pisze.
      match /notes/{id} {
        allow read: if isMember(hid);
        allow create: if isMember(hid) && validSharedNote(hid, request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(hid) && validSharedNote(hid, request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && isAuthorOrAdmin(hid);
        allow delete: if isMember(hid) && isAuthorOrAdmin(hid);
      }

      // Budżet. Kategorie czytają wszyscy (nie zdradzają kwot); wydatki i plany tylko Administrator.
      match /categories/{id} {
        allow read: if isMember(hid);
        allow create, update: if isAdmin(hid) && validCategory(request.resource.data);
        allow delete: if isAdmin(hid);
      }
      match /expenses/{id} {
        allow read: if isAdmin(hid);
        allow create: if isAdmin(hid) && validExpense(hid, request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isAdmin(hid) && validExpense(hid, request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isAdmin(hid);
      }
      match /budgetPlans/{month} {
        allow read: if isAdmin(hid);
        allow write: if isAdmin(hid) && validBudgetPlan(request.resource.data)
          && month.matches('^[0-9]{4}-[0-9]{2}$');
      }

      // Reguły obowiązków: członkowie czytają, Administrator pisze.
      match /choreRules/{id} {
        allow read: if isMember(hid);
        allow create: if isAdmin(hid) && validChoreRule(hid, request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isAdmin(hid) && validChoreRule(hid, request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isAdmin(hid);
      }

      // Wystąpienia obowiązków tworzy i usuwa serwer. Odhacza przypisana osoba (lub każdy,
      // gdy obowiązek jest dla „kogoś”) albo Administrator; zmieniają się tylko pola statusu.
      match /choreOccurrences/{id} {
        allow read: if isMember(hid);
        allow create, delete: if false;
        allow update: if isMember(hid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'doneBy', 'doneAt'])
          && request.resource.data.status in ['todo', 'done', 'skipped']
          && (resource.data.get('assigneeId', null) == null
              || resource.data.assigneeId == request.auth.uid
              || isAdmin(hid))
          && (request.resource.data.status == 'todo'
              ? (request.resource.data.get('doneBy', null) == null
                 && request.resource.data.get('doneAt', null) == null)
              : (request.resource.data.doneBy == request.auth.uid
                 && request.resource.data.doneAt is timestamp));
      }

      // Typy wydarzeń (nazwa + kolor) definiuje Administrator; czytają wszyscy.
      match /eventTypes/{id} {
        allow read: if isMember(hid);
        allow create, update: if isAdmin(hid) && validEventType(request.resource.data);
        allow delete: if isAdmin(hid);
      }

      // Wydarzenia wspólne: wszyscy czytają; autor lub Administrator pisze.
      match /events/{id} {
        allow read: if isMember(hid);
        allow create: if isMember(hid) && validSharedEvent(hid, request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(hid) && validSharedEvent(hid, request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && isAuthorOrAdmin(hid);
        allow delete: if isMember(hid) && isAuthorOrAdmin(hid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
